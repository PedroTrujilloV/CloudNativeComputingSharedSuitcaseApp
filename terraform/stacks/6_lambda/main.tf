locals {
  pipeline_native_map = jsondecode(data.aws_secretsmanager_secret_version.pipeline_native_map.secret_string)

  # Image based Lambda: the image is built by the deploy pipeline from the
  # card_worker folder and pushed to the ECR repository of the 2_registry
  # stack (same name and tag as the config.yaml entry of card_worker).
  ecr_image_uri = "${data.aws_caller_identity.current.account_id}.dkr.ecr.${var.aws_region}.amazonaws.com/${var.image_repository_name}:${var.image_tag}"

  # The academic lab accounts do not allow iam:CreateRole or
  # iam:PutRolePolicy, so the worker uses the LabRole that every lab
  # account provisions in advance instead of creating its own least
  # privilege execution role. The lab role allows the integrations of the
  # flow (DynamoDB, SQS, SNS, the read only discovery of the ingress load
  # balancer, and the function logs).
  lab_role_arn = "arn:aws:iam::${data.aws_caller_identity.current.account_id}:role/LabRole"
}

resource "aws_lambda_function" "card_worker" {
  function_name = var.lambda_function_name
  # Image based function: the AWS provider defaults package_type to "Zip",
  # which would require a handler/runtime; the image is built by the deploy
  # pipeline and pushed to ECR (see the local above).
  package_type = "Image"
  image_uri    = local.ecr_image_uri
  # Pre-provisioned execution role of the academic lab accounts (the
  # stacks of these accounts cannot create their own IAM roles).
  role        = local.lab_role_arn
  timeout     = var.lambda_timeout_seconds
  memory_size = var.lambda_memory_mb

  environment {
    variables = {
      # AWS_REGION is not set here: it is a reserved key of the Lambda
      # runtime (the runtime always provides it, and the worker reads it
      # from the process environment).
      APP_NAME                = "card_worker"
      LOG_LEVEL               = "INFO"
      DYNAMODB_TABLE_NAME     = data.aws_dynamodb_table.credit_cards.name
      # TRUENATIVE_URL is intentionally not set: on AWS the worker
      # discovers the external host of the platform (the ingress load
      # balancer) at runtime, because that host only exists once the k8s
      # deploy step has run and its name is generated by the cluster.
      # Same token the k8s side uses (truenative-secret): both read the
      # SECRET_TOKEN key of the 'secrets-pipeline-native-map' secret.
      TRUENATIVE_SECRET_TOKEN = local.pipeline_native_map["SECRET_TOKEN"]
      CARD_RESULT_TOPIC_ARN   = data.aws_sns_topic.card_verification.arn
      POLL_MAX_ATTEMPTS       = var.poll_max_attempts
      POLL_INTERVAL_SECONDS   = var.poll_interval_seconds
      HTTP_TIMEOUT_SECONDS    = var.http_timeout_seconds
      MAX_RECEIVE_COUNT       = var.max_receive_count
    }
  }
}

# One card per invocation: clean idempotency semantics (a failure affects
# only its own message) and no batching window, so the event is delivered
# as soon as the queue polling finds it.
resource "aws_lambda_event_source_mapping" "card_verification" {
  function_name                      = aws_lambda_function.card_worker.function_name
  event_source_arn                   = data.aws_sqs_queue.card_verification.arn
  batch_size                         = 1
  maximum_batching_window_in_seconds = 0
}
