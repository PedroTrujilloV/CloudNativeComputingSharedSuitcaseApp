# Copie este archivo a ".env" (en esta misma carpeta) y complete los valores.
# El archivo ".env" no debe subirse al repositorio (ya está en scripts/.gitignore).

# Ambiente a desplegar/probar/destruir: student1, student2, student3, student4 o tutor
ENVIRONMENT=student1

# Credenciales de AWS. En cuentas de AWS Academy son temporales y expiran cada
# pocas horas: si un script falla con un error de autenticación de AWS,
# genere credenciales nuevas y actualice este archivo.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Obligatorio solo cuando ENVIRONMENT=tutor: bucket S3 donde vive el state de
# terraform de tutor (debe existir de antes en la cuenta de AWS).
TF_STATE_BUCKET_NAME=

# Usado solo cuando ENVIRONMENT=tutor: debe coincidir EXACTAMENTE con el
# nombre del repositorio en GitHub (sin el usuario/organización), para que el
# state de terraform quede en la misma ruta que cuando corría en CI. Si se
# deja vacío, se usa el nombre de la carpeta del proyecto.
REPO_NAME=

# Credenciales de base de datos que usan los stacks de terraform. Opcionales:
# si ningún stack las necesita, déjelas vacías.
DB_USERNAME=
DB_PASSWORD=

# Correo al que deben llegar las notificaciones de la entrega 3 (usado solo
# por test-entrega3.sh).
EMAIL_TO_NOTIFY=

# Cualquier otro secret que sus stacks de terraform o su aplicación necesiten,
# con el mismo nombre que usarían como secret de GitHub. deploy.sh sube a
# Secrets Manager todo lo definido en este archivo excepto las variables de
# arriba (AWS_*, ENVIRONMENT, TF_STATE_BUCKET_NAME, REPO_NAME), igual que hace
# el pipeline de GitHub Actions.
# JWT_SECRET=
