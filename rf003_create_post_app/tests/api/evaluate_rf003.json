{
  "info": {
    "_postman_id": "9f2c1a4e-7b3d-4e5a-8c6f-0a1b2c3d4e5f",
    "name": "evaluate_rf003",
    "description": "Collection to verify the RF-003 orchestrator (POST /rf003/posts): auth + body validation gate and the core orchestration (route find-or-create, expireAt validation, duplicate-post rule, 201 shape). Run the Setup folder first to create a user and obtain a valid token. A pre-request script generates a unique flightId per run so the happy path and duplicate scenarios are repeatable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8001", "type": "string" },
    { "key": "usersUrl", "value": "http://localhost:8000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "flightId", "value": "", "type": "string" },
    { "key": "pastFlightId", "value": "", "type": "string" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "const ts = Date.now().toString(36).toUpperCase();",
          "pm.collectionVariables.set(\"flightId\", \"PM\" + ts);",
          "pm.collectionVariables.set(\"pastFlightId\", \"PAST\" + ts);"
        ],
        "type": "text/javascript",
        "packages": {}
      }
    }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Create user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 and user was created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"rf003tester\",\n  \"password\": \"Secret123!\",\n  \"email\": \"rf003tester@example.com\",\n  \"dni\": \"12345678\",\n  \"fullName\": \"RF003 Tester\",\n  \"phoneNumber\": \"3001112233\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{usersUrl}}/users",
              "host": ["{{usersUrl}}"],
              "path": ["users"]
            }
          },
          "response": []
        },
        {
          "name": "Authenticate (save token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 and token was issued\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    let body = pm.response.json();",
                  "    pm.expect(body).to.have.property(\"token\");",
                  "    pm.collectionVariables.set(\"token\", body.token);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"rf003tester\",\n  \"password\": \"Secret123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{usersUrl}}/users/auth",
              "host": ["{{usersUrl}}"],
              "path": ["users", "auth"]
            }
          },
          "response": []
        }
      ]
