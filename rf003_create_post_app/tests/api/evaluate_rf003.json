    {
      "name": "Orchestration",
      "item": [
        {
          "name": "Valid request -> 201 (route created + post created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Body has data + msg (msg is a sibling of data)\", function () {",
                  "    let body = pm.response.json();",
                  "    pm.expect(body).to.have.property(\"data\");",
                  "    pm.expect(body).to.have.property(\"msg\");",
                  "    let d = body.data;",
                  "    pm.expect(d).to.have.property(\"id\");",
                  "    pm.expect(d).to.have.property(\"userId\");",
                  "    pm.expect(d).to.have.property(\"createdAt\");",
                  "    pm.expect(d).to.have.property(\"expireAt\");",
                  "    pm.expect(d).to.have.property(\"route\");",
                  "    pm.expect(d.route).to.have.property(\"id\");",
                  "    pm.expect(d.route).to.have.property(\"createdAt\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flightId\": \"{{flightId}}\",\n  \"expireAt\": \"2026-09-15T10:00:00\",\n  \"plannedStartDate\": \"2026-10-01T10:00:00\",\n  \"plannedEndDate\": \"2026-10-02T10:00:00\",\n  \"origin\": { \"airportCode\": \"BOG\", \"country\": \"Colombia\" },\n  \"destiny\": { \"airportCode\": \"MAD\", \"country\": \"Spain\" },\n  \"bagCost\": 350\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/rf003/posts",
              "host": ["{{baseUrl}}"],
              "path": ["rf003", "posts"]
            }
          },
          "response": []
