        {
            "name": "Owner Access",
            "item": [
                {
                    "name": "Owner queries own post (200)",
                    "event": [
                        {
                            "type": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status is 200', function () {\n    pm.response.to.have.status(200);\n});\npm.test('Response body has data.route and data.offers', function () {\n    var data = pm.response.json();\n    pm.expect(data).to.have.property('data');\n    pm.expect(data.data).to.have.property('route');\n    pm.expect(data.data).to.have.property('offers');\n    pm.expect(data.data.route).to.have.property('origin');\n    pm.expect(data.data.route).to.have.property('destiny');\n    pm.expect(data.data.route.origin).to.have.property('airportCode');\n    pm.expect(data.data.route.origin).to.have.property('country');\n    pm.expect(data.data.route.destiny).to.have.property('airportCode');\n    pm.expect(data.data.route.destiny).to.have.property('country');\n    pm.expect(data.data.offers).to.be.an('array');\n});\npm.test('Offers are sorted by score descending (nulls last)', function () {\n    var offers = pm.response.json().data.offers;\n    for (var i = 1; i < offers.length; i++) {\n        var prev = offers[i-1].score === null ? -Infinity : offers[i-1].score;\n        var cur = offers[i].score === null ? -Infinity : offers[i].score;\n        pm.expect(prev).to.be.at.least(cur);\n    }\n});"
                                ]
                            }
                        }
                    ],
