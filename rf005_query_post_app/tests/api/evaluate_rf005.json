                {
                    "name": "Create test post (via RF-003)",
                    "event": [
                        {
                            "type": "prerequest",
                            "script": {
                                "exec": [
                                    "var now = new Date();\nfunction pad(n) { return String(n).padStart(2, '0'); }\nfunction iso(d) {\n    return d.getUTCFullYear() + '-' + pad(d.getUTCMonth() + 1) + '-' + pad(d.getUTCDate())\n        + 'T' + pad(d.getUTCHours()) + ':' + pad(d.getUTCMinutes()) + ':' + pad(d.getUTCSeconds());\n}\n// Dates must satisfy: now < expireAt <= plannedStartDate < plannedEndDate\npm.environment.set('EXPIRE_AT', iso(new Date(now.getTime() + 14 * 24 * 3600 * 1000)));\npm.environment.set('START_AT', iso(new Date(now.getTime() + 30 * 24 * 3600 * 1000)));\npm.environment.set('END_AT', iso(new Date(now.getTime() + 32 * 24 * 3600 * 1000)));\npm.environment.set('FLIGHT', 'PM' + Date.now());"
                                ]
                            }
                        },
                        {
                            "type": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status is 201', function () {\n    pm.response.to.have.status(201);\n});\nvar data = pm.response.json();\nif (pm.response.code === 201) {\n    pm.environment.set('POST_ID', data.data.id);\n}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{TOKEN_OWNER}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\"flightId\":\"{{FLIGHT}}\",\"expireAt\":\"{{EXPIRE_AT}}\",\"plannedStartDate\":\"{{START_AT}}\",\"plannedEndDate\":\"{{END_AT}}\",\"origin\":{\"airportCode\":\"BOG\",\"country\":\"Colombia\"},\"destiny\":{\"airportCode\":\"MAD\",\"country\":\"Spain\"},\"bagCost\":350}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/rf003/posts",
                            "host": [
