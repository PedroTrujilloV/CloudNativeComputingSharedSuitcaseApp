      "name": "Setup",
      "item": [
        {
          "name": "Create owner user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 and user was created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.collectionVariables.set(\"ownerId\", pm.response.json().id);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"rf004owner\",\n  \"password\": \"Secret123!\",\n  \"email\": \"rf004owner@example.com\",\n  \"dni\": \"12345678\",\n  \"fullName\": \"RF004 Owner\",\n  \"phoneNumber\": \"3001112233\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{usersUrl}}/users",
              "host": ["{{usersUrl}}"],
              "path": ["users"]
            }
          },
          "response": []
