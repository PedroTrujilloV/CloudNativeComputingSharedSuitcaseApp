{
  "info": {
    "_postman_id": "4a7e9c21-5d18-4f6b-9e3a-2b8c7d6e5f40",
    "name": "evaluate_rf004",
    "description": "Collection to verify the RF-004 orchestrator (POST /rf004/posts/{id}/offers): auth + validation gate and the full offer creation flow. Run the Setup folder first: it creates an owner user and a caller user, obtains both tokens, creates a route (needed for score calculation), and creates an owner post (valid) plus a short-lived owner post (expires ~2s after creation, for the expired-post scenario). Run the collection in order; by the time the expired-post request runs, the short-lived post has expired. A fully valid request creates the offer and persists its score, answering 201 with the offer data and a summary message.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8001", "type": "string" },
    { "key": "usersUrl", "value": "http://localhost:8000", "type": "string" },
    { "key": "postsUrl", "value": "http://localhost:8003", "type": "string" },
    { "key": "routesUrl", "value": "http://localhost:8002", "type": "string" },
    { "key": "scoresUrl", "value": "http://localhost:8005", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "ownerToken", "value": "", "type": "string" },
    { "key": "ownerId", "value": "", "type": "string" },
    { "key": "postId", "value": "", "type": "string" },
    { "key": "expiredPostId", "value": "", "type": "string" },
    { "key": "routeId", "value": "", "type": "string" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "function iso(offsetMs) {",
          "    return new Date(Date.now() + offsetMs).toISOString().replace(\".\", \"\").slice(0, -2) + \"Z\";",
          "}",
          "pm.collectionVariables.set(\"futureExpireAt\", iso(1000 * 60 * 60 * 24));",
          "pm.collectionVariables.set(\"soonExpireAt\", iso(2000));",
          "pm.collectionVariables.set(\"routeStart\", iso(1000 * 60 * 60));",
          "pm.collectionVariables.set(\"routeEnd\", iso(1000 * 60 * 60 * 25));"
        ],
        "type": "text/javascript",
        "packages": {}
      }
    }
  ],
  "item": [
